{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(//Users/mohammad/.claude/**)",
      "Edit(//Users/mohammad/.claude/**)",
      "Read(//Users/mohammad/Desktop/code/mt-devkit/**)",
      "Edit(//Users/mohammad/Desktop/code/mt-devkit/**)",
      "Read(//Users/mohammad/Desktop/code/devkit/**)",
      "Edit(//Users/mohammad/Desktop/code/devkit/**)",
      "WebFetch(*)",
      "WebSearch",
      "Skill(*)",
      "mcp__playwright-isolated__*",
      "mcp__linear__*",
      "mcp__notion__*",
      "mcp__sentry__*",
      "mcp__datadog-official__*",
      "mcp__slack__*",
      "mcp__rootly__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/Desktop/code/mt-devkit/.claude/hooks/worktree_gate_hook.py\""
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/Desktop/code/mt-devkit/.claude/hooks/implementer_gate_hook.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/Desktop/code/mt-devkit/.claude/hooks/branch_from_main_guard_hook.py\""
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/Desktop/code/mt-devkit/.claude/hooks/permission_guard_hook.py\""
          }
        ]
      }
    ]
  }
}
